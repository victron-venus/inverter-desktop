{
  "schema_version": 1,
  "plugin_id": "inverter-desktop.frigate",
  "version": "0.1.0",
  "host_api": "^1.2",
  "target": "TARGET",
  "entrypoint": "bin/inverter-frigate-worker",
  "permissions": [
    "dashboard_contributions",
    "plugin_configuration",
    "network_mqtt",
    "desktop_notifications"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mqtt_host"],
    "properties": {
      "mqtt_host": {
        "type": "string",
        "title": "MQTT broker host",
        "description": "Hostname or IP address of the broker used by Frigate.",
        "minLength": 1,
        "maxLength": 253
      },
      "mqtt_port": {
        "type": "integer",
        "title": "MQTT broker port",
        "minimum": 1,
        "maximum": 65535,
        "default": 1883
      },
      "mqtt_tls": {
        "type": "boolean",
        "title": "Use TLS",
        "description": "Require a server certificate trusted by the worker's TLS roots.",
        "default": false
      },
      "mqtt_topic": {
        "type": "string",
        "title": "Frigate events topic",
        "description": "One exact topic; MQTT wildcard subscriptions are not supported.",
        "minLength": 1,
        "maxLength": 256,
        "default": "frigate/events"
      },
      "mqtt_username": {
        "type": "string",
        "title": "MQTT username",
        "writeOnly": true,
        "maxLength": 1024
      },
      "mqtt_password": {
        "type": "string",
        "title": "MQTT password",
        "writeOnly": true,
        "maxLength": 1024
      }
    }
  },
  "inventory": [],
  "signature": null
}
