{
  "schema_version": 1,
  "plugin_id": "inverter-desktop.frigate",
  "version": "0.2.0",
  "host_api": "^1.3",
  "target": "TARGET",
  "entrypoint": "bin/inverter-frigate-worker",
  "permissions": [
    "dashboard_contributions",
    "plugin_configuration",
    "network_mqtt",
    "desktop_notifications",
    "http_video"
  ],
  "http_video": { "base_url_setting": "frigate_base_url" },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mqtt_host"],
    "properties": {
      "mqtt_host": {
        "type": "string",
        "title": "MQTT broker host",
        "description": "Hostname or IP address of the broker used by Frigate.",
        "minLength": 1,
        "maxLength": 253
      },
      "mqtt_port": {
        "type": "integer",
        "title": "MQTT broker port",
        "minimum": 1,
        "maximum": 65535,
        "default": 1883
      },
      "mqtt_tls": {
        "type": "boolean",
        "title": "Use TLS",
        "description": "Require a server certificate trusted by the worker's TLS roots.",
        "default": false
      },
      "mqtt_topic": {
        "type": "string",
        "title": "Frigate events topic",
        "description": "One exact topic; MQTT wildcard subscriptions are not supported.",
        "minLength": 1,
        "maxLength": 256,
        "default": "frigate/events"
      },
      "frigate_base_url": {
        "type": "string",
        "title": "Frigate HTTP address",
        "description": "Optional direct HTTP(S) address for completed clips, including any port or path prefix. Leave blank for motion notifications only. Credentials, queries and fragments are not supported.",
        "maxLength": 2048
      },
      "mqtt_username": {
        "type": "string",
        "title": "MQTT username",
        "writeOnly": true,
        "maxLength": 1024
      },
      "mqtt_password": {
        "type": "string",
        "title": "MQTT password",
        "writeOnly": true,
        "maxLength": 1024
      }
    }
  },
  "inventory": [],
  "signature": null
}
