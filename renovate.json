{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "cargo",
    "custom.jsonata",
    "custom.regex",
    "github-actions",
    "gradle",
    "gradle-wrapper",
    "npm",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "matchPackageNames": [
        "@commitlint/*"
      ],
      "groupName": "commitlint",
      "groupSlug": "commitlint",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "matchPackageNames": [
        "@univerjs/*"
      ],
      "groupName": "univer",
      "groupSlug": "univer",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ]
  }
}
